        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"database_metadata\" (\"id\" INTEGER NOT NULL, \"database_id\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, \"last_changed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
