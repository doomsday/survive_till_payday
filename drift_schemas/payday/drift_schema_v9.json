          "sql": "CREATE TABLE IF NOT EXISTS \"database_history_changes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity_table\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"recorded_at\" INTEGER NOT NULL, \"operation\" TEXT NOT NULL, \"before_json\" TEXT NULL, \"after_json\" TEXT NULL);"
